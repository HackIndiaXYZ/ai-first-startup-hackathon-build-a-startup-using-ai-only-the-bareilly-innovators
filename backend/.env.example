# ── Gemini API Key Pool ────────────────────────────────────────────────────
# Primary key (required). Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional extra keys from additional Google accounts (each = +1500 req/day free)
# Uncomment and fill in to multiply your free quota:
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=

# ── Other API Keys ────────────────────────────────────────────────────────
GNEWS_API_KEY=
OPENROUTER_API_KEY=

# ── Phase 3: Mobile Handoff (Telegram) ───────────────────────────────────
# Step 1: Create a bot → message @BotFather on Telegram → /newbot
# Step 2: Get your chat_id → message @userinfobot on Telegram
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# TELEGRAM_CHAT_ID=987654321

# ── Phase 2: Offline Fallback (Ollama) ───────────────────────────────────
# Install Ollama from https://ollama.ai
# Then run: ollama pull llama3.1:8b
# Sivi will auto-detect Ollama when internet is unavailable
# OLLAMA_URL=http://localhost:11434

# ── Optional Settings ─────────────────────────────────────────────────────
# USER_NAME=Your Name
# AI_MODE=sivi
